[0m12:00:09.691488 [debug] [Thread-5  ]: Using snowflake connection "model.analytics.agg_returned_orders_by_month"
[0m12:00:09.691781 [debug] [Thread-5  ]: On model.analytics.agg_returned_orders_by_month: create or replace   view analytics.dbt_lbk_fusion_mig.agg_returned_orders_by_month
  
  
  
  
  as (
    with fct_order_items as (
    select * from analytics.dbt_lbk_fusion_mig.fct_order_items
),

final as (
    select
        date_trunc(MONTH, fct_order_items.order_date) as order_month 
        , count(case when is_return then order_item_key else null end) as returned_orders
        , 1.0* returned_orders / nullif (
            count(order_item_key)
            , 0
        ) as return_rate
        , count(*) as row_count
    from fct_order_items
    group by 1
    order by 1 desc
)

select * from final
  )
