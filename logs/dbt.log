00:26:09.897182 [debug]: Query executed on node model.analytics.agg_returned_orders_by_month:
create or replace   view analytics.dbt_lbk_fusion_mig.agg_returned_orders_by_month
  
   as (
    with fct_order_items as (
    select * from analytics.dbt_lbk_fusion_mig.fct_order_items
),

final as (
    select
        date_trunc(MONTH, fct_order_items.order_date) as order_month 
        , count(case when is_return then order_item_key else null end) as returned_orders
        , 1.0* returned_orders / nullif (
            count(order_item_key)
            , 0
        ) as return_rate
        , count(*) as row_count
    from fct_order_items
    group by 1
    order by 1 desc
)

select * from final  
  )
/* {"app":"dbt","dbt_version":"2.0.0","profile_name":"analytics","target_name":"dev","node_id":"model.analytics.agg_returned_orders_by_month"} */
 Succeeded [  1.56s] model dbt_lbk_fusion_mig.agg_returned_orders_by_month (view)
00:26:10.041565 [debug]: Query executed on node model.analytics.agg_daily_returned_orders:
create or replace   view analytics.dbt_lbk_fusion_mig.agg_daily_returned_orders
  
   as (
    
with fct_order_items as (
    select * from analytics.dbt_lbk_fusion_mig.fct_order_items
),

final as (
    select
        fct_order_items.order_date as ds
        , cast(1.0*count(case when is_return then order_item_key else null end) as float) as y
    from fct_order_items
    group by 1
    order by 1 desc
)

select * from final  
  )
