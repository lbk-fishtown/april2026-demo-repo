create or replace temporary table analytics.dbt_lbk_fusion_mig.stg_tpch_orders_2_2__dw_src
        
        as 
        with source_data as (
        select 
            *
            , lag(dw_hash_diff) over (partition by order_key order by dw_strt_ts asc) as dw_hash_diff_prev , lag(dw_rec_del_ind) over (partition by order_key order by dw_strt_ts asc) as dw_rec_del_ind_prev
        from
        (
        select 
            md5(upper(nvl(to_varchar(order_key), '')))::varchar(32) as dw_hash_key
                , md5(upper(nvl(to_varchar(customer_key), '') || '|' || nvl(to_varchar(status_code), '') || '|' || nvl(to_varchar(total_price), '') || '|' || nvl(to_varchar(order_date), '') || '|' || nvl(to_varchar(order_time), '') || '|' || nvl(to_varchar(priority_code), '') || '|' || nvl(to_varchar(clerk_name), '') || '|' || nvl(to_varchar(ship_priority), '') || '|' || nvl(to_varchar(comment), '')))::varchar(32) as dw_hash_diff
            , date_trunc(day,order_date)::timestamp as dw_strt_ts/**/
                    , false::boolean as dw_rec_del_ind
            , s.* 
        from analytics.dbt_lbk_fusion_mig.stg_tpch_orders_2_2__dw_sql s
        )
    )
    , processed_source_data as (
    select 
        current_session() as dw_batch_id,
        s.dw_rec_del_ind, 
        s.dw_strt_ts, 
        date_trunc(day,lead(dateadd(nanosecond, -1 ,s.dw_strt_ts), 1, '9999-12-31 23:59:59.999999999') over (partition by s.order_key order by s.dw_strt_ts asc, s.order_date desc))::timestamp as dw_end_ts, 
        s.dw_hash_key,
        current_timestamp()::timestamp as dw_process_ts,
        s.ORDER_KEY, s.CUSTOMER_KEY, s.STATUS_CODE, s.TOTAL_PRICE, s.ORDER_DATE, s.ORDER_TIME, s.PRIORITY_CODE, s.CLERK_NAME, s.SHIP_PRIORITY, s.COMMENT
    from  source_data s
    where 1=0
    or s.dw_hash_diff_prev is null 
    or s.dw_hash_diff_prev <> s.dw_hash_diff 
    or ( s.dw_rec_del_ind <> s.dw_rec_del_ind_prev )
    )
    select 
        psd.dw_batch_id
        , psd.dw_process_ts 
        , psd.dw_rec_del_ind 
        , psd.dw_strt_ts
        , psd.dw_end_ts
        , psd.dw_hash_key 
        
        , psd.ORDER_KEY, psd.CUSTOMER_KEY, psd.STATUS_CODE, psd.TOTAL_PRICE, psd.ORDER_DATE, psd.ORDER_TIME, psd.PRIORITY_CODE, psd.CLERK_NAME, psd.SHIP_PRIORITY, psd.COMMENT
    from processed_source_data psd
